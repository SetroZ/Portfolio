datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Article {
  id       Int       @id @default(autoincrement())
  date     DateTime  @default(now())
  title    String
  subtitle String
  body     String
  image    String?
  Comment  Comment[]
}

model Comment {
  id         Int      @id @default(autoincrement())
  date       DateTime @default(now())
  name       String
  Article    Article  @relation(fields: [article_id], references: [id])
  article_id Int
}

